# --- Required ---
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_TOKEN=
GITHUB_OWNER=Ginesbros

# --- Recommended / Optional ---
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
XAI_API_KEY=
VERCEL_TOKEN=
MANUS_API_KEY=
HIGGSFIELD_API_KEY=
NOTEBOOKLM_API_KEY=

# --- Service ---
PORT=3001

# --- Budget ---
BUDGET_MODE=starter_400
MONTHLY_BUDGET_USD=400
SOFT_BUDGET_PERCENT=80
HARD_BUDGET_PERCENT=100

# --- Worker ---
WORKER_ENABLED=true
WORKER_ID=worker-1
WORKER_CONCURRENCY=1
WORKER_POLL_MS=10000
TASK_LOCK_MINUTES=20

# --- Limits ---
MAX_TASK_RETRIES=3
MAX_PROJECT_TASKS=20
MAX_DEBUG_LOOPS=2

# --- Sandbox ---
SANDBOX_ROOT=/tmp/ai-builder-sandboxes
SANDBOX_TIMEOUT_MS=180000
SANDBOX_MAX_OUTPUT_CHARS=12000
APP_PORT=4173

# --- Provider routing per role (best-of-breed defaults) ---
# planner -> Claude Opus, debugger -> OpenAI, reviewer -> Claude+Gemini+Grok panel
PLANNER_PROVIDER=anthropic
PLANNER_MODEL=claude-opus-4-5
DEBUGGER_PROVIDER=openai
DEVELOPER_PROVIDER=openai
OPENAI_DEBUGGER_MODEL=gpt-4.1

# Per-task-type developer model overrides (smart routing)
DEV_DEFAULT_MODEL=gpt-4.1-mini
DEV_SETUP_MODEL=gpt-4.1-mini
DEV_FRONTEND_MODEL=gpt-4.1-mini
DEV_BACKEND_MODEL=gpt-4.1
DEV_DATABASE_MODEL=gpt-4.1
DEV_INTEGRATION_MODEL=gpt-4.1
DEV_TEST_MODEL=gpt-4.1-mini
DEV_DEPLOY_MODEL=gpt-4.1-mini

# Reviewer panel
REVIEWER_CLAUDE_MODEL=claude-sonnet-4-5
REVIEWER_GEMINI_MODEL=gemini-2.5-pro
REVIEWER_GROK_MODEL=grok-4

# Researcher / librarian / image / video / specialist
PERPLEXITY_MODEL=sonar-pro
NOTEBOOKLM_API_BASE=https://generativelanguage.googleapis.com/v1beta
NOTEBOOKLM_MODEL=gemini-2.5-pro
NANO_BANANA_MODEL=gemini-3.1-flash-image-preview
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
HIGGSFIELD_MODEL=higgsfield-v1
MANUS_BASE_URL=https://open.manus.im

# Optional: wait synchronously for long-running tasks (default: async)
SPECIALIST_WAIT_FOR_COMPLETION=false
VIDEOGRAPHER_WAIT_FOR_COMPLETION=false

# --- Cost rates per 1M tokens (used by recordAiUsage) ---
COST_PLANNER_INPUT_PER_1M=2.00
COST_PLANNER_OUTPUT_PER_1M=8.00
COST_DEVELOPER_INPUT_PER_1M=0.40
COST_DEVELOPER_OUTPUT_PER_1M=1.60
COST_DEBUGGER_INPUT_PER_1M=2.00
COST_DEBUGGER_OUTPUT_PER_1M=8.00
COST_REVIEWER_INPUT_PER_1M=0.40
COST_REVIEWER_OUTPUT_PER_1M=1.60
COST_RESEARCH_FLAT_PER_CALL=0.01
COST_IMAGE_FLAT_PER_IMAGE=0.04
COST_VIDEO_FLAT_PER_SECOND=0.10
# Designer (text → image prompt LLM call)
COST_DESIGNER_INPUT_PER_1M=0.40
COST_DESIGNER_OUTPUT_PER_1M=1.60
# Librarian (NotebookLM / Gemini)
COST_LIBRARIAN_INPUT_PER_1M=1.25
COST_LIBRARIAN_OUTPUT_PER_1M=5.00

# --- Auth (protects /debug routes and /api in production) ---
ADMIN_TOKEN=
